# Neon PostgreSQL connection string (wajib di Vercel Environment Variables)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# JWT secret untuk token auth (wajib di production)
JWT_SECRET=your-strong-random-secret-key

# Port lokal untuk Express (opsional, default 3001)
PORT=3001
